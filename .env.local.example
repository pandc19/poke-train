# Database (role + database created by scripts/setup-db.sh in the postgres18 container)
DATABASE_URL="postgresql://poketrain:poketrain_dev_password@localhost:5432/poketrain_dev?schema=public"

# AI audits and research (optional -- no key means no-AI mode, the app still works)
AI_PROVIDER="openai"          # "openai" | "claude"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_WORKSPACE_ID="wrkspc_..."   # REQUIRED if the API answers 400 "not scoped to a workspace"; same value taxap uses
# CLAUDE_MODEL="claude-opus-5-5"         # or claude-sonnet-5-5 / claude-haiku-5-5 for lower cost
